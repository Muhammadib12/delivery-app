// Delivery Platform - Israel | Kabul | +972 | ILS
// Phase 1: Full schema from DATABASE_SCHEMA.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_STAFF
  DRIVER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING_VERIFICATION
}

enum RestaurantStatus {
  OPEN
  CLOSED
  BUSY
  TEMPORARILY_CLOSED
  PENDING_APPROVAL
  SUSPENDED
}

enum RestaurantStaffRole {
  OWNER
  MANAGER
  STAFF
}

enum DriverVerificationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverAvailabilityStatus {
  OFFLINE
  ONLINE
  ON_DELIVERY
}

enum DocumentType {
  NATIONAL_ID
  DRIVING_LICENSE
  VEHICLE_REGISTRATION
  PROFILE_PHOTO
}

enum OrderStatus {
  PENDING_RESTAURANT
  ACCEPTED_BY_RESTAURANT
  REJECTED_BY_RESTAURANT
  PREPARING
  LOOKING_FOR_DRIVER
  DRIVER_OFFERED
  DRIVER_ASSIGNED
  DRIVER_ARRIVED_RESTAURANT
  PICKED_UP
  ON_THE_WAY
  ARRIVED_CUSTOMER
  DELIVERED
  CANCELLED
  FAILED
}

enum DeliveryStatus {
  PENDING
  DRIVER_ASSIGNED
  DRIVER_HEADING_TO_RESTAURANT
  DRIVER_ARRIVED_RESTAURANT
  PICKED_UP
  ON_THE_WAY
  ARRIVED_CUSTOMER
  DELIVERED
  CANCELLED
}

enum DriverOfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  TIMED_OUT
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum CommissionType {
  PERCENTAGE
  FLAT_FEE
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
  ESCALATED
}

enum NotificationType {
  ORDER_PLACED
  ORDER_ACCEPTED
  ORDER_REJECTED
  ORDER_PREPARING
  DRIVER_ASSIGNED
  DRIVER_ARRIVED_RESTAURANT
  ORDER_PICKED_UP
  ORDER_ON_THE_WAY
  ORDER_DELIVERED
  ORDER_CANCELLED
  DELIVERY_REQUEST
  DRIVER_APPROVED
  DRIVER_REJECTED
  SYSTEM_ANNOUNCEMENT
  SUPPORT_REPLY
}

// ─────────────────────────────────────────────
// 4.1 IDENTITY & ACCESS
// ─────────────────────────────────────────────

model User {
  id           String     @id @default(uuid())
  phone        String?    @db.VarChar(20)
  email        String?    @db.VarChar(255)
  passwordHash String?    @map("password_hash") @db.VarChar(255)
  role         UserRole
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  // Relations
  refreshTokens          RefreshToken[]
  deviceTokens           DeviceToken[]
  userSessions           UserSession[]
  customerProfile        CustomerProfile?
  driverProfile          DriverProfile?
  restaurantStaff        RestaurantStaff[]
  orderStatusHistory     OrderStatusHistory[]
  orderCancellations     OrderCancellation[]  @relation("CancelledByUser")
  notifications          Notification[]
  supportTicketsReported SupportTicket[]      @relation("ReporterTickets")
  supportTicketsAssigned SupportTicket[]      @relation("AssignedTickets")
  supportMessages        SupportMessage[]
  auditLogs              AuditLog[]
  refundsIssued          Refund[]
  platformSettings       PlatformSetting[]

  @@unique([phone], name: "uq_users_phone")
  @@unique([email], name: "uq_users_email")
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

model RefreshToken {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  tokenHash         String   @unique @map("token_hash") @db.VarChar(255)
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(255)
  ipAddress         String?  @map("ip_address")
  expiresAt         DateTime @map("expires_at")
  isRevoked         Boolean  @default(false) @map("is_revoked")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String   @db.VarChar(20)
  codeHash  String   @map("code_hash") @db.VarChar(255)
  attempts  Int      @default(0) @db.SmallInt
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([phone])
  @@map("otp_codes")
}

model DeviceToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  fcmToken   String   @unique @map("fcm_token") @db.VarChar(512)
  platform   String   @db.VarChar(10)
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

model UserSession {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  deviceFingerprint String?  @map("device_fingerprint") @db.VarChar(255)
  ipAddress         String?  @map("ip_address")
  lastActiveAt      DateTime @default(now()) @map("last_active_at")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_sessions")
}

// ─────────────────────────────────────────────
// 4.2 CUSTOMER DOMAIN
// ─────────────────────────────────────────────

model CustomerProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  displayName      String?  @map("display_name") @db.VarChar(100)
  profilePhotoUrl  String?  @map("profile_photo_url")
  defaultAddressId String?  @map("default_address_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  addresses      CustomerAddress[]
  defaultAddress CustomerAddress?  @relation("DefaultAddress", fields: [defaultAddressId], references: [id], onDelete: SetNull)
  carts          Cart[]
  orders         Order[]

  @@index([userId])
  @@map("customer_profiles")
}

model CustomerAddress {
  id         String    @id @default(uuid())
  customerId String    @map("customer_id")
  label      String    @db.VarChar(50)
  street     String    @db.VarChar(255)
  city       String    @db.VarChar(100)
  district   String?   @db.VarChar(100)
  landmark   String?   @db.VarChar(255)
  latitude   Decimal   @db.Decimal(10, 7)
  longitude  Decimal   @db.Decimal(10, 7)
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  customer        CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  defaultForUsers CustomerProfile[] @relation("DefaultAddress")
  orders          Order[]

  @@index([customerId])
  @@index([deletedAt])
  @@map("customer_addresses")
}

model Cart {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  restaurantId String   @map("restaurant_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  restaurant Restaurant      @relation(fields: [restaurantId], references: [id])
  items      CartItem[]

  @@unique([customerId, restaurantId], name: "uq_carts_customer_restaurant")
  @@index([customerId])
  @@index([restaurantId])
  @@map("carts")
}

model CartItem {
  id                String   @id @default(uuid())
  cartId            String   @map("cart_id")
  productId         String   @map("product_id")
  quantity          Int      @default(1) @db.SmallInt
  selectedModifiers Json?    @map("selected_modifiers")
  notes             String?  @db.VarChar(300)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// ─────────────────────────────────────────────
// 4.3 RESTAURANT DOMAIN
// ─────────────────────────────────────────────

model RestaurantCategory {
  id        String   @id @default(uuid())
  name      String   @unique @db.VarChar(100)
  iconUrl   String?  @map("icon_url")
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  restaurants Restaurant[]

  @@map("restaurant_categories")
}

model Restaurant {
  id                  String           @id @default(uuid())
  categoryId          String?          @map("category_id")
  name                String           @db.VarChar(150)
  description         String?
  logoUrl             String?          @map("logo_url")
  bannerUrl           String?          @map("banner_url")
  address             String?          @db.VarChar(500)
  latitude            Decimal?         @db.Decimal(10, 7)
  longitude           Decimal?         @db.Decimal(10, 7)
  status              RestaurantStatus @default(PENDING_APPROVAL)
  commissionRate      Decimal?         @map("commission_rate") @db.Decimal(5, 2)
  avgPrepTimeMinutes  Int?             @default(30) @map("avg_prep_time_minutes") @db.SmallInt
  minOrderAmount      Decimal          @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  deliveryFeeOverride Decimal?         @map("delivery_fee_override") @db.Decimal(10, 2)
  rating              Decimal          @default(0.00) @db.Decimal(3, 2)
  totalReviews        Int              @default(0) @map("total_reviews")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  deletedAt           DateTime?        @map("deleted_at")

  category       RestaurantCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  staff          RestaurantStaff[]
  workingHours   RestaurantWorkingHour[]
  menuCategories MenuCategory[]
  products       Product[]
  carts          Cart[]
  orders         Order[]
  commissions    Commission[]

  @@index([categoryId])
  @@index([status])
  @@index([latitude, longitude])
  @@index([deletedAt])
  @@map("restaurants")
}

model RestaurantStaff {
  id           String              @id @default(uuid())
  userId       String              @map("user_id")
  restaurantId String              @map("restaurant_id")
  role         RestaurantStaffRole @default(STAFF)
  permissions  Json?
  isActive     Boolean             @default(true) @map("is_active")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  user       User       @relation(fields: [userId], references: [id])
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  @@unique([userId, restaurantId], name: "uq_restaurant_staff_user_restaurant")
  @@index([userId])
  @@index([restaurantId])
  @@map("restaurant_staff")
}

model RestaurantWorkingHour {
  id           String  @id @default(uuid())
  restaurantId String  @map("restaurant_id")
  dayOfWeek    Int     @map("day_of_week") @db.SmallInt
  openTime     String? @map("open_time")
  closeTime    String? @map("close_time")
  isClosed     Boolean @default(false) @map("is_closed")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, dayOfWeek], name: "uq_restaurant_working_hours_day")
  @@index([restaurantId])
  @@map("restaurant_working_hours")
}

model MenuCategory {
  id           String   @id @default(uuid())
  restaurantId String   @map("restaurant_id")
  name         String   @db.VarChar(100)
  sortOrder    Int      @default(0) @map("sort_order") @db.SmallInt
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model Product {
  id             String    @id @default(uuid())
  restaurantId   String    @map("restaurant_id")
  menuCategoryId String    @map("menu_category_id")
  name           String    @db.VarChar(150)
  description    String?
  price          Decimal   @db.Decimal(10, 2)
  isAvailable    Boolean   @default(true) @map("is_available")
  sortOrder      Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuCategory MenuCategory      @relation(fields: [menuCategoryId], references: [id])
  images       ProductImage[]
  modifiers    ProductModifier[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([restaurantId])
  @@index([menuCategoryId])
  @@index([isAvailable])
  @@index([deletedAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  url       String
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductModifier {
  id            String  @id @default(uuid())
  productId     String  @map("product_id")
  name          String  @db.VarChar(100)
  isRequired    Boolean @default(false) @map("is_required")
  minSelections Int     @default(0) @map("min_selections") @db.SmallInt
  maxSelections Int     @default(1) @map("max_selections") @db.SmallInt
  sortOrder     Int     @default(0) @map("sort_order") @db.SmallInt

  product Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  options ProductModifierOption[]

  @@index([productId])
  @@map("product_modifiers")
}

model ProductModifierOption {
  id              String  @id @default(uuid())
  modifierId      String  @map("modifier_id")
  name            String  @db.VarChar(100)
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  isDefault       Boolean @default(false) @map("is_default")
  sortOrder       Int     @default(0) @map("sort_order") @db.SmallInt

  modifier ProductModifier @relation(fields: [modifierId], references: [id], onDelete: Cascade)

  @@index([modifierId])
  @@map("product_modifier_options")
}

// ─────────────────────────────────────────────
// 4.4 ORDER DOMAIN
// ─────────────────────────────────────────────

model Order {
  id                   String        @id @default(uuid())
  customerId           String        @map("customer_id")
  restaurantId         String        @map("restaurant_id")
  addressId            String?       @map("address_id")
  addressSnapshot      Json          @map("address_snapshot")
  status               OrderStatus   @default(PENDING_RESTAURANT)
  subtotal             Decimal       @db.Decimal(10, 2)
  deliveryFee          Decimal       @map("delivery_fee") @db.Decimal(10, 2)
  total                Decimal       @db.Decimal(10, 2)
  paymentMethod        PaymentMethod @map("payment_method")
  deliveryNotes        String?       @map("delivery_notes") @db.VarChar(500)
  idempotencyKey       String        @unique @map("idempotency_key") @db.VarChar(100)
  estimatedPrepMinutes Int?          @map("estimated_prep_minutes") @db.SmallInt
  autoRejectAt         DateTime?     @map("auto_reject_at")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")
  deletedAt            DateTime?     @map("deleted_at")

  customer      CustomerProfile      @relation(fields: [customerId], references: [id])
  restaurant    Restaurant           @relation(fields: [restaurantId], references: [id])
  address       CustomerAddress?     @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  cancellation  OrderCancellation?
  delivery      Delivery?
  payment       Payment?
  notifications Notification[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid())
  orderId             String  @map("order_id")
  productId           String? @map("product_id")
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(150)
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity            Int     @db.SmallInt
  lineTotal           Decimal @map("line_total") @db.Decimal(10, 2)
  notes               String? @db.VarChar(300)

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  modifiers OrderItemModifier[]

  @@index([orderId])
  @@map("order_items")
}

model OrderItemModifier {
  id                      String  @id @default(uuid())
  orderItemId             String  @map("order_item_id")
  modifierNameSnapshot    String  @map("modifier_name_snapshot") @db.VarChar(100)
  optionNameSnapshot      String  @map("option_name_snapshot") @db.VarChar(100)
  priceAdjustmentSnapshot Decimal @default(0) @map("price_adjustment_snapshot") @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
  @@map("order_item_modifiers")
}

model OrderStatusHistory {
  id         String       @id @default(uuid())
  orderId    String       @map("order_id")
  actorId    String?      @map("actor_id")
  actorType  String?      @map("actor_type") @db.VarChar(30)
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?      @db.VarChar(500)
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model OrderCancellation {
  id          String   @id @default(uuid())
  orderId     String   @unique @map("order_id")
  cancelledBy String?  @map("cancelled_by")
  actorType   String   @map("actor_type") @db.VarChar(30)
  reason      String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation("CancelledByUser", fields: [cancelledBy], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_cancellations")
}

// ─────────────────────────────────────────────
// 4.5 DRIVER DOMAIN
// ─────────────────────────────────────────────

model DriverProfile {
  id                 String                   @id @default(uuid())
  userId             String                   @unique @map("user_id")
  displayName        String?                  @map("display_name") @db.VarChar(100)
  profilePhotoUrl    String?                  @map("profile_photo_url")
  vehicleType        String?                  @map("vehicle_type") @db.VarChar(50)
  vehiclePlate       String?                  @map("vehicle_plate") @db.VarChar(30)
  vehicleColor       String?                  @map("vehicle_color") @db.VarChar(50)
  verificationStatus DriverVerificationStatus @default(PENDING_REVIEW) @map("verification_status")
  rejectionReason    String?                  @map("rejection_reason")
  availabilityStatus DriverAvailabilityStatus @default(OFFLINE) @map("availability_status")
  rating             Decimal                  @default(0.00) @db.Decimal(3, 2)
  totalDeliveries    Int                      @default(0) @map("total_deliveries")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents     DriverDocument[]
  locations     DriverLocation[]
  deliveries    Delivery[]
  offers        DriverOffer[]
  statusHistory DriverStatusHistory[]
  earnings      DriverEarning[]

  @@index([userId])
  @@index([verificationStatus])
  @@index([availabilityStatus])
  @@map("driver_profiles")
}

model DriverDocument {
  id               String       @id @default(uuid())
  driverId         String       @map("driver_id")
  documentType     DocumentType @map("document_type")
  url              String
  originalFilename String?      @map("original_filename") @db.VarChar(255)
  uploadedAt       DateTime     @default(now()) @map("uploaded_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, documentType], name: "uq_driver_documents_driver_type")
  @@index([driverId])
  @@map("driver_documents")
}

model DriverLocation {
  id         String   @id @default(uuid())
  driverId   String   @map("driver_id")
  latitude   Decimal  @db.Decimal(10, 7)
  longitude  Decimal  @db.Decimal(10, 7)
  accuracy   Decimal? @db.Decimal(6, 2)
  heading    Decimal? @db.Decimal(5, 2)
  speed      Decimal? @db.Decimal(6, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([recordedAt])
  @@map("driver_locations")
}

model Delivery {
  id                  String         @id @default(uuid())
  orderId             String         @unique @map("order_id")
  driverId            String?        @map("driver_id")
  status              DeliveryStatus @default(PENDING)
  assignedAt          DateTime?      @map("assigned_at")
  arrivedRestaurantAt DateTime?      @map("arrived_restaurant_at")
  pickedUpAt          DateTime?      @map("picked_up_at")
  arrivedCustomerAt   DateTime?      @map("arrived_customer_at")
  deliveredAt         DateTime?      @map("delivered_at")
  cancelledAt         DateTime?      @map("cancelled_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  driver  DriverProfile? @relation(fields: [driverId], references: [id])
  offers  DriverOffer[]
  earning DriverEarning?

  @@index([orderId])
  @@index([driverId])
  @@index([status])
  @@map("deliveries")
}

model DriverOffer {
  id          String            @id @default(uuid())
  deliveryId  String            @map("delivery_id")
  driverId    String            @map("driver_id")
  status      DriverOfferStatus @default(PENDING)
  offeredAt   DateTime          @default(now()) @map("offered_at")
  expiresAt   DateTime          @map("expires_at")
  respondedAt DateTime?         @map("responded_at")

  delivery Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver   DriverProfile @relation(fields: [driverId], references: [id])

  @@unique([deliveryId, driverId], name: "uq_driver_offers_delivery_driver")
  @@index([deliveryId])
  @@index([driverId])
  @@index([status])
  @@map("driver_offers")
}

model DriverStatusHistory {
  id         String                    @id @default(uuid())
  driverId   String                    @map("driver_id")
  fromStatus DriverAvailabilityStatus? @map("from_status")
  toStatus   DriverAvailabilityStatus  @map("to_status")
  createdAt  DateTime                  @default(now()) @map("created_at")

  driver DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([createdAt])
  @@map("driver_status_history")
}

model DriverEarning {
  id                 String       @id @default(uuid())
  deliveryId         String       @unique @map("delivery_id")
  driverId           String       @map("driver_id")
  grossAmount        Decimal      @map("gross_amount") @db.Decimal(10, 2)
  commissionDeducted Decimal      @map("commission_deducted") @db.Decimal(10, 2)
  netAmount          Decimal      @map("net_amount") @db.Decimal(10, 2)
  payoutStatus       PayoutStatus @default(PENDING) @map("payout_status")
  createdAt          DateTime     @default(now()) @map("created_at")

  delivery Delivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  driver   DriverProfile @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([payoutStatus])
  @@map("driver_earnings")
}

// ─────────────────────────────────────────────
// 4.6 PAYMENT & FINANCE DOMAIN
// ─────────────────────────────────────────────

model Payment {
  id               String        @id @default(uuid())
  orderId          String        @unique @map("order_id")
  method           PaymentMethod
  status           PaymentStatus @default(PENDING)
  amount           Decimal       @db.Decimal(10, 2)
  gatewayReference String?       @map("gateway_reference") @db.VarChar(255)
  collectedAt      DateTime?     @map("collected_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  order   Order          @relation(fields: [orderId], references: [id])
  events  PaymentEvent[]
  refunds Refund[]

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

model PaymentEvent {
  id         String         @id @default(uuid())
  paymentId  String         @map("payment_id")
  fromStatus PaymentStatus? @map("from_status")
  toStatus   PaymentStatus  @map("to_status")
  note       String?        @db.VarChar(500)
  createdAt  DateTime       @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_events")
}

model Refund {
  id               String   @id @default(uuid())
  paymentId        String   @map("payment_id")
  issuedBy         String?  @map("issued_by")
  amount           Decimal  @db.Decimal(10, 2)
  reason           String?  @db.VarChar(500)
  gatewayReference String?  @map("gateway_reference") @db.VarChar(255)
  createdAt        DateTime @default(now()) @map("created_at")

  payment      Payment @relation(fields: [paymentId], references: [id])
  issuedByUser User?   @relation(fields: [issuedBy], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

model Commission {
  id            String         @id @default(uuid())
  restaurantId  String?        @map("restaurant_id")
  type          CommissionType @default(PERCENTAGE)
  rate          Decimal?       @db.Decimal(5, 2)
  flatAmount    Decimal?       @map("flat_amount") @db.Decimal(10, 2)
  effectiveFrom DateTime       @default(now()) @map("effective_from")
  effectiveTo   DateTime?      @map("effective_to")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([isActive])
  @@map("commissions")
}

// ─────────────────────────────────────────────
// 4.7 NOTIFICATION DOMAIN
// ─────────────────────────────────────────────

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  orderId   String?          @map("order_id")
  type      NotificationType
  title     String           @db.VarChar(150)
  body      String           @db.VarChar(500)
  data      Json?
  isRead    Boolean          @default(false) @map("is_read")
  sentAt    DateTime?        @map("sent_at")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────
// 4.8 SUPPORT & ADMIN DOMAIN
// ─────────────────────────────────────────────

model SupportTicket {
  id          String              @id @default(uuid())
  reporterId  String              @map("reporter_id")
  orderId     String?             @map("order_id")
  assignedTo  String?             @map("assigned_to")
  status      SupportTicketStatus @default(OPEN)
  type        String              @db.VarChar(50)
  subject     String              @db.VarChar(200)
  description String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  resolvedAt  DateTime?           @map("resolved_at")

  reporter       User             @relation("ReporterTickets", fields: [reporterId], references: [id])
  assignedToUser User?            @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  messages       SupportMessage[]

  @@index([reporterId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

model SupportMessage {
  id        String   @id @default(uuid())
  ticketId  String   @map("ticket_id")
  senderId  String   @map("sender_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id])

  @@index([ticketId])
  @@index([createdAt])
  @@map("support_messages")
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String   @map("admin_id")
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(50)
  entityId    String?  @map("entity_id")
  beforeValue Json?    @map("before_value")
  afterValue  Json?    @map("after_value")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PlatformSetting {
  id          String   @id @default(uuid())
  key         String   @unique @db.VarChar(100)
  value       String
  dataType    String   @default("string") @map("data_type") @db.VarChar(20)
  description String?  @db.VarChar(500)
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedBy   String?  @map("updated_by")

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([key])
  @@map("platform_settings")
}
