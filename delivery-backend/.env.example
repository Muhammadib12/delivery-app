# ══════════════════════════════════════════════════════════════════════════════
# Delivery Platform — Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
#
# HOW TO USE:
#   1. Copy this file:   cp .env.example .env
#   2. Fill in your values below
#   3. Never commit .env — only .env.example goes to Git
#
# ══════════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# NODE_ENV options: development | test | production

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Example: http://localhost:3001,https://yourapp.com,capacitor://localhost
CORS_ORIGINS=http://localhost:3001,capacitor://localhost

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://delivery_user:YOUR_PASSWORD@localhost:5432/delivery_db"

# ─── Redis ────────────────────────────────────────────────────────────────────
# Format: redis://HOST:PORT  or  redis://:PASSWORD@HOST:PORT
REDIS_URL=redis://localhost:6379

# ─── JWT ──────────────────────────────────────────────────────────────────────
# IMPORTANT: Generate strong secrets before deploying to staging/production
# Run this to generate: openssl rand -base64 64
JWT_ACCESS_SECRET=REPLACE_WITH_STRONG_SECRET_MIN_32_CHARS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_SECRET_MIN_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── SMS Provider — Israel +972 ───────────────────────────────────────────────
# SMS_PROVIDER options:
#   mock    → logs OTP to console (use in development/test)
#   twilio  → sends real SMS via Twilio (use in staging/production)
SMS_PROVIDER=mock
SMS_PHONE_PREFIX=+972
SMS_SENDER_NAME=DELIVERY

# Twilio credentials (required only when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
SMS_API_KEY=

# ─── Firebase Cloud Messaging (FCM) ───────────────────────────────────────────
# Set FCM_ENABLED=true and fill credentials to enable push notifications
# Leave FCM_ENABLED=false in development — notifications will be logged only
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ─── Cloudinary — Image Upload ────────────────────────────────────────────────
# Get these from cloudinary.com → Dashboard
# All uploaded images are auto-converted to WebP
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
